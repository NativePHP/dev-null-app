{
    "name": "devnull/commit-row",
    "description": "The dev/null Log's commit row as one native element, for measuring against the same row drawn with EDGE.",
    "type": "nativephp-ui-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Devnull\\CommitRow\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devnull\\CommitRow\\CommitRowServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
