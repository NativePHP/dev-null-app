{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "simonhamp/devnull-mobile",
    "type": "project",
    "description": "Native iOS and Android client for devnull, built with NativePHP Mobile.",
    "keywords": [
        "laravel",
        "framework",
        "nativephp",
        "mobile"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/NativePHP/mobile-air"
        },
        {
            "type": "vcs",
            "url": "https://github.com/NativePHP/mobile-ui"
        },
        {
            "name": "nativephp-plugins",
            "type": "composer",
            "url": "https://plugins.nativephp.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "codingwithrk/nativephp-social-auth": "^1.0",
        "laravel/boost": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "nativephp/mobile": "dev-combined/dev-null-app as 4.6.0",
        "nativephp/mobile-browser": "^1.2",
        "nativephp/mobile-camera": "^1.1",
        "nativephp/mobile-secure-storage": "^1.1",
        "nativephp/mobile-share": "^1.1",
        "nativephp/mobile-ui": "dev-combined/dev-null-app as 0.8.0",
        "s2br/nativephp-mobile-splashscreen": "^1.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "setup:free": [
            "@php -r \"copy('composer.json', 'composer.free.json'); copy('composer.lock', 'composer.free.lock');\"",
            "@putenv COMPOSER=composer.free.json",
            "@composer config --unset repositories.nativephp-plugins",
            "@composer remove nativephp/mobile-secure-storage --no-interaction",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan native:install"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
