{
    "namespace": "Calls",
    "bridge_functions": [
        {
            "name": "Calls.Start",
            "android": "com.devnull.plugins.calls.CallsFunctions.Start",
            "ios": "CallsFunctions.Start",
            "description": "Open the microphone and start a WebRTC connection: an offer to send, or an answer to the offer given"
        },
        {
            "name": "Calls.Answer",
            "android": "com.devnull.plugins.calls.CallsFunctions.Answer",
            "ios": "CallsFunctions.Answer",
            "description": "Apply the partner's answer to the offer this phone made"
        },
        {
            "name": "Calls.SetMuted",
            "android": "com.devnull.plugins.calls.CallsFunctions.SetMuted",
            "ios": "CallsFunctions.SetMuted",
            "description": "Mute or unmute the microphone"
        },
        {
            "name": "Calls.SetSpeaker",
            "android": "com.devnull.plugins.calls.CallsFunctions.SetSpeaker",
            "ios": "CallsFunctions.SetSpeaker",
            "description": "Play the call through the loudspeaker or the earpiece"
        },
        {
            "name": "Calls.End",
            "android": "com.devnull.plugins.calls.CallsFunctions.End",
            "ios": "CallsFunctions.End",
            "description": "Hang up: closes the connection, which ends the call on the partner's side too"
        }
    ],
    "events": [
        "Devnull\\Calls\\Events\\DescriptionReady",
        "Devnull\\Calls\\Events\\Connected",
        "Devnull\\Calls\\Events\\Ended"
    ],
    "android": {
        "min_version": 29,
        "permissions": [
            "android.permission.INTERNET",
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
        ],
        "dependencies": {
            "implementation": [
                "io.getstream:stream-webrtc-android:1.3.10"
            ]
        }
    },
    "ios": {
        "min_version": "18.0",
        "info_plist": {},
        "background_modes": [
            "audio"
        ],
        "dependencies": {
            "swift_packages": [
                {
                    "url": "https://github.com/stasel/WebRTC",
                    "version": "156.0.0",
                    "products": [
                        "WebRTC"
                    ]
                }
            ],
            "pods": []
        }
    }
}
