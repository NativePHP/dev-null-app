 // MARK: - Header
+
+/// A pager with its header beside the pages rather than above them, from
+/// `header_beside_from` points of window up: the header scrolls by itself
+/// in the leading column, and the tabs and pages fill the trailing one.
+/// Without a header this is just the pages, so the pager keeps its state
+/// when the window narrows and the header goes back above the tabs.
+private struct PagerHeaderBeside<Pages: View>: View {
+    let header: NativeUINode?
+    @ViewBuilder let pages: Pages
+
+    @State private var split = PagerSplit.even(0)
+
+    var body: some View {
+        HStack(spacing: 0) {
+            if let header {
+                ScrollView(.vertical) {
+                    PagerChildren(node: header)
+                        .frame(maxWidth: .infinity, alignment: .leading)
+                }
+                .frame(width: split.leading)
+                Color.clear
+                    .frame(width: split.gap)
+                    .accessibilityHidden(true)
+            }
+            pages
+        }
+        .onGeometryChange(for: PagerSplit.self) { PagerSplit(in: $0) } action: { split = $0 }
+    }
+}
+
+/// Where a pager splits into its header and its pages. On a foldable it is
+/// the fold, flat or not, which neither column draws in: Apple's guidance
+/// keeps controls out of it. Anywhere else, or when the fold isn't across
+/// the pager, the columns share the width evenly.
+private struct PagerSplit: Equatable {
+    var leading: CGFloat
+    var gap: CGFloat
+
+    static func even(_ width: CGFloat) -> PagerSplit {
+        PagerSplit(leading: (width / 2).rounded(), gap: 0)
+    }
+
+    init(leading: CGFloat, gap: CGFloat) {
+        self.leading = leading
+        self.gap = gap
+    }
+
+    init(in proxy: GeometryProxy) {
+        let width = proxy.size.width
+        self = .even(width)
+        #if compiler(>=6.4)
+        if #available(iOS 27.1, *) {
+            let folds = proxy.reservedRegions(kind: .division, options: .includeInactive)
+            if let fold = folds.first(where: { $0.frame.height > $0.frame.width && $0.frame.minX > 0 && $0.frame.maxX < width }) {
+                self = PagerSplit(leading: fold.frame.minX, gap: fold.frame.width)
+            }
+        }
+        #endif
+    }
+}
 
