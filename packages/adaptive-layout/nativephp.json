{
    "namespace": "AdaptiveLayout",
    "platforms": ["ios"],
    "android": {
        "min_version": 26
    },
    "ios": {
        "min_version": "18.2"
    },
    "components": [
        {
            "type": "adaptive_feed",
            "element": "Devnull\\AdaptiveLayout\\Elements\\AdaptiveFeed",
            "blade": "Devnull\\AdaptiveLayout\\Components\\AdaptiveFeed",
            "ios_renderer": "AdaptiveFeedRenderer",
            "self_closing": false
        },
        {
            "type": "adaptive_detail",
            "element": "Devnull\\AdaptiveLayout\\Elements\\AdaptiveDetail",
            "blade": "Devnull\\AdaptiveLayout\\Components\\AdaptiveDetail",
            "ios_renderer": "AdaptiveDetailRenderer",
            "self_closing": false
        },
        {
            "type": "adaptive_placeholder",
            "element": "Devnull\\AdaptiveLayout\\Elements\\AdaptivePlaceholder",
            "blade": "Devnull\\AdaptiveLayout\\Components\\AdaptivePlaceholder",
            "ios_renderer": "AdaptiveDetailRenderer",
            "self_closing": false
        }
    ]
}
