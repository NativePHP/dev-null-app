+
+/// Watches the system tab bar for a tap on the already-selected item.
+/// SwiftUI's TabView does not report that tap, so this attaches a
+/// non-cancelling recognizer to the underlying UITabBar. It only
+/// observes; it does not replace the bar or its delegate.
+private struct TabBarReselectObserver: UIViewRepresentable {
+    let visibleIndices: [Int]
+    let onReselect: (Int) -> Void
+
+    func makeCoordinator() -> Coordinator {
+        Coordinator(visibleIndices: visibleIndices, onReselect: onReselect)
+    }
+
+    func makeUIView(context: Context) -> UIView {
+        let view = UIView(frame: .zero)
+        view.isUserInteractionEnabled = false
+        context.coordinator.attach(from: view)
+
+        return view
+    }
+
+    func updateUIView(_ uiView: UIView, context: Context) {
+        context.coordinator.visibleIndices = visibleIndices
+        context.coordinator.onReselect = onReselect
+        context.coordinator.attach(from: uiView)
+    }
+
+    final class Coordinator: NSObject, UIGestureRecognizerDelegate {
+        var visibleIndices: [Int]
+        var onReselect: (Int) -> Void
+        private weak var tabBar: UITabBar?
+        private var recognizer: UITapGestureRecognizer?
+
+        init(visibleIndices: [Int], onReselect: @escaping (Int) -> Void) {
+            self.visibleIndices = visibleIndices
+            self.onReselect = onReselect
+        }
+
+        func attach(from view: UIView) {
+            guard tabBar == nil else { return }
+
+            DispatchQueue.main.async { [weak self, weak view] in
+                guard let self, let view, let bar = Self.findTabBar(in: view) else { return }
+
+                let tap = UITapGestureRecognizer(target: self, action: #selector(self.tapped(_:)))
+                tap.cancelsTouchesInView = false
+                tap.delegate = self
+                bar.addGestureRecognizer(tap)
+
+                self.tabBar = bar
+                self.recognizer = tap
+            }
+        }
+
+        @objc private func tapped(_ recognizer: UITapGestureRecognizer) {
+            guard let bar = recognizer.view as? UITabBar,
+                  let items = bar.items, !items.isEmpty,
+                  let selected = bar.selectedItem,
+                  let selectedIndex = items.firstIndex(where: { $0 === selected }) else { return }
+
+            let location = recognizer.location(in: bar)
+
+            guard let tappedIndex = Self.tabIndex(at: location, in: bar, count: items.count),
+                  tappedIndex == selectedIndex,
+                  visibleIndices.indices.contains(tappedIndex) else { return }
+
+            onReselect(visibleIndices[tappedIndex])
+        }
+
+        private static func tabIndex(at location: CGPoint, in bar: UITabBar, count: Int) -> Int? {
+            let buttons = bar.subviews.filter {
+                String(describing: type(of: $0)).contains("TabBarButton")
+            }
+
+            if buttons.count == count,
+               let index = buttons.firstIndex(where: { $0.frame.contains(location) }) {
+                return index
+            }
+
+            guard bar.bounds.width > 0 else { return nil }
+
+            let index = Int((location.x / bar.bounds.width) * CGFloat(count))
+
+            return min(max(index, 0), count - 1)
+        }
+
+        private static func findTabBar(in view: UIView) -> UITabBar? {
+            if let bar = view as? UITabBar, !bar.isHidden, let items = bar.items, !items.isEmpty {
+                return bar
+            }
+
+            for subview in view.subviews {
+                if let found = findTabBar(in: subview) {
+                    return found
+                }
+            }
+
+            return nil
+        }
+
+        func gestureRecognizer(
+            _ gestureRecognizer: UIGestureRecognizer,
+            shouldRecognizeSimultaneouslyWith otherGestureRecognizer: UIGestureRecognizer
+        ) -> Bool {
+            true
+        }
+    }
+}
